# Copy to .env (never commit it) or set these in your host's secret store.
# Key VALUES are never written to logs, the ledger, the browser bundle or the repo.

# --- Qloo (required for live data; without it the app runs on demo data) ---
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com   # production keys: https://api.qloo.com
QLOO_MODE=auto            # auto | live | mock
QLOO_MAX_CALLS_PER_RUN=16 # per-run cap (quota guard)
QLOO_DAILY_BUDGET=800     # per-process daily cap; beyond it runs fall back to demo data
QLOO_CACHE_TTL_S=21600    # in-memory response cache

# --- Writer LLM (optional; scripted writer is used when none is set) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Any OpenAI-compatible endpoint (Hugging Face router, Gemini OpenAI endpoint, Groq, local):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_MODE=auto             # auto | anthropic | openai | off
LLM_MAX_TOOL_CALLS=12

# --- App ---
RUNS_PER_IP_PER_10MIN=8
PUBLIC_REPO_URL=https://github.com/kbns2000/taste-fit
